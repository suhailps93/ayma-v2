FROM python:3.12-slim AS builder

WORKDIR /app

COPY requirements-agent.txt ./
RUN pip install --no-cache-dir --no-compile --prefix=/install -r requirements-agent.txt

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Multi-stage: only the installed site-packages come from the builder stage,
# so pip/setuptools/wheel and their build-time footprint never reach the
# runtime image (~11% smaller than a single-stage `pip install` here).
COPY --from=builder /install /usr/local
COPY . ./

# No `download-files`: the worker uses Gemini Live's native turn-detection
# (§1.7 step 9), not livekit-agents' local turn-detector / inference models, so
# there is nothing to pre-fetch.

# Cloud Run assigns $PORT; agent.py binds the worker health server to it.
ENV PORT=8080
CMD ["sh", "-c", "exec python agent.py start"]
