FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements-agent.txt ./
RUN pip install --no-cache-dir -r requirements-agent.txt

COPY . ./

# No `download-files`: the worker uses Gemini Live's native turn-detection
# (§1.7 step 9), not livekit-agents' local turn-detector / inference models, so
# there is nothing to pre-fetch.

# Cloud Run assigns $PORT; agent.py binds the worker health server to it.
ENV PORT=8080
CMD ["sh", "-c", "exec python agent.py start"]
