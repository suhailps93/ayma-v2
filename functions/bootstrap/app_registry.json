{
  "_doc": "Single source of truth for what Ayma can open and change in the app (skills/app_control.py reads it; ayma_flutter/test/app_registry_test.dart and tests/test_app_registry.py check every GoRoute in ayma_flutter/lib/routing/app_router.dart against it). A new route must be added to destinations, parameterized or non_navigable (with a reason) or both tests fail.",
  "destinations": [
    {"key": "ayma", "path": "/", "label": "the chat with Ayma", "aliases": ["chat", "home", "ayma tab", "back to chat", "main screen", "talk to ayma"]},
    {"key": "explore", "path": "/explore", "label": "Explore", "aliases": ["explore tab", "browse", "browse people", "search people", "discover"]},
    {"key": "messages", "path": "/messages", "label": "Messages", "aliases": ["inbox", "dms", "messages tab", "conversations", "chats"]},
    {"key": "profile", "path": "/profile", "label": "the You tab", "aliases": ["you", "you tab", "profile tab", "my profile tab", "account", "my account", "profile hub"]},
    {"key": "complete_profile", "path": "/complete-profile", "label": "Complete your profile", "aliases": ["profile completeness", "completeness", "profile completion", "complete my profile", "profile percent", "profile percentage", "how complete is my profile", "completeness card", "profile progress", "profile score", "complete profile card", "your profile is complete"], "found_on": "profile", "on_screen": "the 'Your profile is N% complete' card at the top"},
    {"key": "my_public_profile", "path": "/profile/me/public", "label": "My public profile", "aliases": ["public profile", "my public profile", "what others see", "how others see me", "preview my profile", "public profile page"], "found_on": "profile"},
    {"key": "story", "path": "/profile/wiki", "label": "My story", "aliases": ["my story", "wiki", "ai notes", "what ayma knows about me", "my notes", "version history"], "found_on": "profile"},
    {"key": "profile_details", "path": "/settings/profile", "label": "Profile details (edit profile)", "aliases": ["edit profile", "profile details", "my details", "name and birthdate", "who i want to meet", "partner preferences", "preferences", "age range", "distance", "basic info"], "found_on": "profile"},
    {"key": "my_web_research", "resolve": "my_deep_dive", "path": "/skills", "label": "Search the web about me (your web-research report)", "aliases": ["web research", "search the web about me", "my web report", "deep dive about me", "my deep dive", "web search report", "google myself"], "found_on": "profile"},
    {"key": "my_appearance", "resolve": "my_appearance", "path": "/skills", "label": "Appearance (your appearance report)", "aliases": ["appearance", "appearance report", "my appearance", "my looks report", "face report", "body report", "physical profile"], "found_on": "profile"},
    {"key": "settings", "path": "/settings", "label": "User settings", "aliases": ["user settings", "app settings", "theme settings", "verification", "verify my face", "face verification", "matching settings"], "found_on": "profile"},
    {"key": "ayma_settings", "path": "/settings/ayma", "label": "Ayma's settings", "aliases": ["ayma settings", "her settings", "animation settings", "wing flutter", "memory settings", "wipe memory"], "found_on": "profile"},
    {"key": "credits", "path": "/profile/plan", "label": "Plan (your plan and credits)", "aliases": ["plan", "my plan", "credits", "credit balance", "subscription", "subscribe", "upgrade", "billing", "pricing", "buy credits", "top up", "usage", "plans", "paywall", "pro", "plus", "max plan"], "found_on": "profile"},
    {"key": "invite_friends", "path": "/invite-friends", "label": "Invite friends", "aliases": ["invite", "invite a friend", "referral", "share my link", "refer a friend"], "found_on": "profile"},
    {"key": "feedback", "path": "/profile/feedback", "label": "Send feedback", "aliases": ["send feedback", "report a bug", "bug report", "suggest a feature", "feature request"], "found_on": "profile"},
    {"key": "terms", "path": "/terms", "label": "Terms of Service", "aliases": ["terms of service", "tos", "terms and conditions", "legal"], "found_on": "profile"},
    {"key": "privacy", "path": "/privacy", "label": "Privacy Policy", "aliases": ["privacy policy", "data policy", "what you collect"], "found_on": "profile"},
    {"key": "matches", "path": "/matches", "label": "New matches", "aliases": ["my matches", "new matches", "match list", "who matched"]},
    {"key": "photos", "path": "/profile/me/public?edit=photos", "label": "your photos", "aliases": ["my photos", "photo management", "edit photos", "manage photos", "add photos", "pictures", "profile pictures"]},
    {"key": "skills", "path": "/skills", "label": "Skills", "aliases": ["skills", "ayma skills", "run a deep dive", "tools"]},
    {"key": "voice_preference", "path": "/settings/voice", "label": "Ayma's voice", "aliases": ["voice", "voice settings", "her voice", "accent", "voice accent", "language", "voice language", "ayma voice"], "found_on": "ayma_settings"},
    {"key": "accent_color", "path": "/settings/accent-color", "label": "Accent colour", "aliases": ["accent colour", "accent color", "app colour", "app color", "colour picker", "color picker", "theme colour", "theme color"], "found_on": "settings"},
    {"key": "notifications", "path": "/notifications", "label": "Notifications", "aliases": ["notification center", "notification centre", "alerts", "my notifications", "bell"]},
    {"key": "notification_settings", "path": "/notifications/prefs", "label": "Notification preferences", "aliases": ["notification preferences", "notification prefs", "notification settings", "push notifications", "push settings", "mute notifications"]},
    {"key": "delete_account", "path": "/settings/delete-account", "label": "Delete account", "aliases": ["delete account", "delete my account", "close my account", "remove my account", "account deletion"], "found_on": "settings"},
    {"key": "biometric_consent", "path": "/settings/biometric-consent", "label": "Face matching consent", "aliases": ["face matching consent", "biometric consent", "my consent", "consent settings", "consent page", "what i agreed to"], "found_on": "settings"},
    {"key": "biometric_info", "path": "/legal/biometric", "label": "Biometric information (face matching) policy", "aliases": ["biometric policy", "biometric information", "face matching policy", "face data policy"]},
    {"key": "release_notes", "path": "/whats-new", "label": "What's new", "aliases": ["whats new", "what's new", "release notes", "changelog", "updates", "new features"], "found_on": "settings"}
  ],
  "parameterized": [
    {"route": "/dm/:threadId", "via": "open_message_thread", "reason": "one DM thread with a specific person"},
    {"route": "/match/:matchId", "via": "open_match_report", "reason": "the match report for one specific person"},
    {"route": "/match-request/:matchId", "via": "open_screen notifications", "reason": "a pending match request, opened from its notification"},
    {"route": "/profile/user/:uid", "via": "open_profile", "reason": "a specific person's profile"},
    {"route": "/deep-dive/:id", "via": "open_screen my_web_research", "reason": "a web-research report; the user's own one resolves via my_web_research"},
    {"route": "/appearance/:id", "via": "open_screen my_appearance", "reason": "an Appearance report; the user's own one resolves via my_appearance"},
    {"route": "/physical-attributes/:id", "via": "open_screen my_appearance", "reason": "a legacy physical-profile report, folded into the Appearance report history"}
  ],
  "non_navigable": [
    {"route": "/consent", "reason": "biometric consent gate; the router forces it while consent is required and it must only ever be answered by the user's own tap"},
    {"route": "/splash", "reason": "app start-up bootstrap; re-running it mid-session would restart the app flow"},
    {"route": "/under-18", "reason": "age-gate outcome screen (18+ gate); never opened on request"},
    {"route": "/signin", "reason": "sign-in screen; a signed-in user is redirected away from it"},
    {"route": "/preboarding", "reason": "first-run onboarding interview; only reached from splash"},
    {"route": "/chat", "reason": "pre-signup marketing chat; the signed-in chat is the ayma destination"},
    {"route": "/recover", "reason": "deleted-account recovery flow, reached only at sign-in"},
    {"route": "/s/:token", "reason": "public shared-report link opened from outside the app"},
    {"route": "/settings/photos", "reason": "legacy redirect to the photos destination"},
    {"route": "/profile/usage", "reason": "legacy redirect to the Plan page (credits destination)"},
    {"route": "/profile/usage/plans", "reason": "legacy redirect to the Plan page (credits destination)"},
    {"route": "/profile/subscription", "reason": "legacy redirect to the Plan page (credits destination)"},
    {"route": "/profile/usage/trial", "reason": "trial paywall needs a server-issued offer; payment pages open as the Plan page only"},
    {"route": "/settings/google-account", "reason": "Google account linking is hidden from the v1 UI"},
    {"route": "/settings/instagram", "reason": "Instagram is V2, behind the meta_integrations flag (default off)"},
    {"route": "/settings/developer", "reason": "hidden developer panel (tap the build stamp in User settings seven times)"}
  ],
  "settings": [
    {"key": "theme", "label": "Theme", "kind": "enum", "values": ["light", "dark", "system"], "aliases": ["dark mode", "light mode", "system theme", "match system", "night mode", "appearance mode"], "handler": "client", "client_command": {"light": "light_mode", "dark": "dark_mode", "system": "system_theme"}, "done": {"light": "Switched you to light mode.", "dark": "Switched you to dark mode.", "system": "Matched the app's theme to your system setting."}, "found_on": "settings"},
    {"key": "accent_color", "label": "Accent colour (any #RRGGBB)", "kind": "hex", "aliases": ["accent colour", "accent color", "app colour", "app color", "theme colour", "theme color"], "handler": "client", "client_command": "accent_color", "found_on": "accent_color"},
    {"key": "pause_matching", "label": "Pause matching (hide from Explore and new matches)", "kind": "bool", "aliases": ["pause", "hide me", "hide my profile", "invisible", "pause my profile", "resume matching", "unpause"], "handler": "client", "client_command": {"on": "pause_matching", "off": "resume_matching"}, "done": {"on": "Paused matching — you're hidden from Explore and new match sourcing.", "off": "Resumed matching — you're visible again."}, "found_on": "settings"},
    {"key": "wing_flutter", "label": "Wing flutter animation (the orb's petal motion)", "kind": "bool", "aliases": ["wing animation", "flutter animation", "orb animation", "petal animation", "animation"], "handler": "client", "client_command": "wing_flutter", "found_on": "ayma_settings"},
    {"key": "nav_bar_flutter", "label": "Wing flutter in the nav bar", "kind": "bool", "aliases": ["nav bar animation", "nav bar flutter", "tab bar animation", "small orb animation"], "handler": "client", "client_command": "nav_bar_flutter", "found_on": "ayma_settings"},
    {"key": "notify_dm_message", "label": "Notifications: Direct messages", "kind": "bool", "aliases": ["message notifications", "dm notifications", "direct message notifications"], "handler": "notification_pref", "category": "dm_message", "found_on": "notification_settings"},
    {"key": "notify_mutual_match", "label": "Notifications: New matches", "kind": "bool", "aliases": ["new match notifications", "mutual match notifications"], "handler": "notification_pref", "category": "mutual_match", "found_on": "notification_settings"},
    {"key": "notify_new_scored_match", "label": "Notifications: Ayma found matches", "kind": "bool", "aliases": ["ayma found matches notifications", "scored match notifications"], "handler": "notification_pref", "category": "new_scored_match", "found_on": "notification_settings"},
    {"key": "notify_ayma_checkin", "label": "Notifications: Ayma check-ins", "kind": "bool", "aliases": ["check-in notifications", "checkin notifications"], "handler": "notification_pref", "category": "ayma_checkin", "found_on": "notification_settings"},
    {"key": "notify_skill_result", "label": "Notifications: Deep dive & match results", "kind": "bool", "aliases": ["result notifications", "deep dive notifications", "skill notifications"], "handler": "notification_pref", "category": "skill_result", "found_on": "notification_settings"},
    {"key": "notify_ayma_reply", "label": "Notifications: Ayma replies", "kind": "bool", "aliases": ["reply notifications", "ayma reply notifications"], "handler": "notification_pref", "category": "ayma_reply", "found_on": "notification_settings"},
    {"key": "notify_all", "label": "All notification categories at once", "kind": "bool", "aliases": ["all notifications", "every notification", "notifications"], "handler": "notification_pref", "category": "*", "found_on": "notification_settings"},
    {"key": "partner_age_range", "label": "Partner age range (e.g. 25-35, both 18 or over)", "kind": "age_range", "aliases": ["age range", "partner age", "age preference", "ages"], "handler": "partner_age_range", "found_on": "profile_details"},
    {"key": "distance_preference", "label": "Distance preference (10, 25, 50, 100 miles or anywhere)", "kind": "enum", "values": ["10", "25", "50", "100", "anywhere"], "aliases": ["distance", "how far", "max distance", "search radius", "radius"], "handler": "distance_pref", "found_on": "profile_details"},
    {"key": "profile_fields", "label": "Name, first/last name, phone, birthdate, gender, interested in, location", "kind": "tool", "via": "set_profile_field", "aliases": ["name", "phone", "birthdate", "birthday", "gender", "interested in", "location"], "handler": "tool", "found_on": "profile_details"},
    {"key": "ayma_voice", "label": "Ayma's voice character, accent and spoken language", "kind": "tool", "via": "set_voice_preference", "aliases": ["voice", "accent", "language", "speak"], "handler": "tool", "found_on": "voice_preference"}
  ],
  "account_actions": [
    {"key": "sign_out", "label": "Sign out", "aliases": ["log out", "logout", "sign me out", "signout"], "confirm_phrase": "yes, sign me out", "question": "Sign you out of Ayma on this phone?", "handler": "client", "found_on": "profile"},
    {"key": "delete_account", "label": "Delete account (data removed after 30 days)", "aliases": ["delete my account", "close my account", "remove my account"], "confirm_phrase": "yes, delete my account", "question": "Delete your Ayma account? Your data is removed after 30 days unless you sign back in before then.", "handler": "client", "found_on": "settings"},
    {"key": "withdraw_consent", "label": "Withdraw face matching consent (deletes face data and the account)", "aliases": ["withdraw consent", "revoke consent", "withdraw my consent", "withdraw biometric consent", "revoke biometric consent"], "confirm_phrase": "yes, withdraw and delete", "question": "Withdraw your face matching consent? Ayma can't work without it, so this deletes your face data now and then deletes your account.", "handler": "client", "found_on": "biometric_consent"},
    {"key": "wipe_memory", "label": "Wipe what Ayma has learned (wiki + history; account stays)", "aliases": ["reset wiki", "forget everything", "wipe memory", "reset memory", "clear what you know"], "confirm_phrase": "yes, wipe it", "question": "Wipe everything I've learned about you (your wiki and our history)? Your account, profile and photos stay. This can't be undone.", "handler": "wipe_memory", "found_on": "ayma_settings"}
  ],
  "unavailable": [
    {"key": "purchase", "aliases": ["buy", "purchase", "pay", "pay for", "checkout", "buy credits", "buy more credits", "purchase credits", "subscribe for me", "upgrade for me", "buy a plan"], "say": "Ayma never buys or subscribes on the user's behalf. Open the Plan page (open_screen credits) so they can choose there themselves."},
    {"key": "app_language", "aliases": ["app language", "interface language", "translate the app", "ui language"], "say": "The app's screens are English only. Ayma can speak another language or accent: use set_voice_preference."},
    {"key": "developer_panel", "aliases": ["developer", "developer panel", "dev panel", "debug menu", "developer options"], "say": "The developer panel is hidden on purpose: tap the build stamp at the bottom of User settings seven times."},
    {"key": "connect_google", "aliases": ["connect google", "google account", "link google"], "say": "Connecting a Google account isn't offered in this version of the app."},
    {"key": "connect_instagram", "aliases": ["instagram", "connect instagram", "facebook", "link instagram"], "say": "Instagram and Facebook connections aren't available in this version of the app."}
  ]
}
