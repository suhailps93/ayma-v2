<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ayma</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Ayma</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- The app locks itself to portrait at runtime (SystemChrome in main.dart).
	     These arrays stay permissive so the launch storyboard renders correctly
	     on every device; the Flutter layer does the actual locking. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ===================== Privacy usage strings ===================== -->
	<!-- livekit_client voice sessions (chat screen + the pre-sign-in "welcome"
	     greeting on the sign-in screen). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Ayma uses the microphone so you can talk with her by voice, including during voice calls.</string>
	<!-- geolocator + geocoding: a one-shot lookup during onboarding to pre-fill
	     the user's city, plus — only when you turn on Date moments or the
	     location log in Privacy — occasional location use. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ayma uses your location to detect your city for your profile and nearby matches, and — only if you turn on Date moments or the location log — to recap a planned date when you arrive and to learn your place routines.</string>
	<!-- "Always" authorization backs the opt-in background geofence (the date
	     step-in) and the opt-in location log, when the user enables them in
	     Privacy. Off by default and governed by the master location switch. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>With Date moments or the location log turned on, Ayma uses your location in the background to recap a planned date when you arrive and to learn your place routines. It is off by default, and you can turn location off entirely in Privacy.</string>
	<!-- image_picker: taking a new profile photo with the camera. -->
	<key>NSCameraUsageDescription</key>
	<string>Ayma uses the camera so you can take photos to use as your profile pictures or share in chats.</string>
	<!-- image_picker: choosing an existing profile photo from the library. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ayma needs access to your photo library so you can choose profile pictures or photos to share in chats.</string>
	<!-- Add-only Photos access: "Save image" on the Appearance report card
	     (AppDelegate's ayma/media_save channel). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ayma saves your report card image to your photo library when you tap Save image.</string>

	<!-- ===================== Background execution ===================== -->
	<!-- livekit_client must keep the audio session alive so a voice call keeps
	     running (and audio keeps playing) when the screen locks or the app is
	     briefly backgrounded. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<!-- Opt-in background geofence (date step-in) + opt-in location log. -->
		<string>location</string>
	</array>

	<!-- ===================== Google Sign-In callback ===================== -->
	<!-- google_sign_in needs a URL type whose scheme is the *reversed* iOS OAuth
	     client id so Safari can hand the OAuth result back to the app.
	     Value below is derived from `iosClientId` in lib/firebase_options.dart:
	       235381544962-g1omoiumlqilovh53em3jglq5q7jce8t.apps.googleusercontent.com
	     TODO: after you download ios/Runner/GoogleService-Info.plist from the
	     Firebase console, confirm this exactly equals its REVERSED_CLIENT_ID. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.235381544962-g1omoiumlqilovh53em3jglq5q7jce8t</string>
			</array>
		</dict>
	</array>

	<!-- LSApplicationQueriesSchemes is intentionally omitted: the app only opens
	     https URLs via url_launcher with LaunchMode.externalApplication (Safari)
	     and never calls canLaunchUrl / launchUrl on a custom scheme, so no
	     scheme allow-list is required. Add one here if that changes. -->
</dict>
</plist>
