<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Voice sessions (Step 14): LiveKit / WebRTC audio. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Keep a voice call alive while the app is backgrounded (foreground
         service, microphone type — required from Android 14). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Screen co-pilot: draw the highlight ring over other apps (the
         user grants this once in system settings) and run the
         MediaProjection capture as a mediaProjection foreground
         service (Android 14 requirement). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>

    <!-- Location auto-detect during preboarding (Step 35). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- Saving a chat image or the report card to the gallery on Android 9
         and below only —
         API 29+ writes scoped MediaStore with no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <application
        android:label="Ayma"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Shared-report links (https://justabot.info/s/<token>) open the
                 read-only in-app view. autoVerify needs
                 /.well-known/assetlinks.json (docs/deploy.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="justabot.info"
                    android:pathPrefix="/s/"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Ayma's own FileProvider: the report card's direct WhatsApp /
             Instagram share hands the 1080x1920 PNG (written to the cache-dir
             root) to another app as a content:// URI. share_plus's provider
             only exposes its own cache/share_plus/ subfolder, so it can't
             serve these files — the reason the direct buttons failed while
             "More…" worked. Not exported; each share grants per-URI read
             access (see MainActivity.sendImageToApp). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ayma_file_paths" />
        </provider>

        <!-- Push notifications (FCM) otherwise fall back to the launcher icon,
             which the system renders as a flat square: use the Ayma mark. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ayma_accent" />
        <!-- The IMPORTANCE_HIGH channel (created in MainActivity) the system
             posts background notification-payload pushes on, so they pop as a
             heads-up alert instead of landing silently on FCM's default
             fallback channel. Keep in sync with MainActivity.DEFAULT_CHANNEL_ID
             and notifications_schema.ANDROID_DEFAULT_CHANNEL. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ayma_default" />

        <!-- DM pushes arrive as data-only messages and are rendered here as a
             chat-style notification (sender avatar, per-conversation stack).
             It extends the firebase_messaging plugin's service — which is
             removed below so FCM has exactly one MESSAGING_EVENT receiver —
             and delegates every non-DM push to it. -->
        <service
            android:name=".DmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
        <service
            android:name="io.flutter.plugins.firebase.messaging.FlutterFirebaseMessagingService"
            tools:node="remove" />

        <!-- F4: ongoing "Ayma" call notification (title / live status / Hang
             Up / Mute) shown while a voice call is backgrounded — the
             foreground-service equivalent of ChatGPT's voice-call
             notification. android:foregroundServiceType is required from
             Android 14 (API 34) for any service calling startForeground()
             with FOREGROUND_SERVICE_MICROPHONE. -->
        <!-- Ayma Keyboard V1: the user enables this IME in system
             keyboard settings and switches to it explicitly. BIND_INPUT_METHOD
             is the system-only permission every keyboard declares. -->
        <service
            android:name=".AymaKeyboardService"
            android:label="Ayma Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/ayma_keyboard_method" />
        </service>
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Screen co-pilot capture: MediaProjection foreground service.
             Started only from the in-app co-pilot screen after the
             per-session system consent; never exported. -->
        <service
            android:name=".CopilotProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Instagram Stories share target (package visibility, Android 11+). -->
        <intent>
            <action android:name="com.instagram.share.ADD_TO_STORY"/>
            <data android:mimeType="image/png"/>
        </intent>
        <!-- System share sheet targets (WhatsApp etc.): share_plus resolves
             senders to grant them read access to the card image. -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="image/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
        <!-- Report card "Instagram Stories": a direct image send to Instagram. -->
        <package android:name="com.instagram.android"/>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
