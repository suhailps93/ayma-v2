<?xml version="1.0" encoding="utf-8"?>
<!-- Notification status-bar / small icon. Also doubles as the corner badge
     glyph CallStyle stamps onto the caller's large icon (see the
     buildNotification() comment) — same drawable, both places, per AOSP's
     conversation_icon_badge chrome (there is no separate API to give the
     badge a different glyph than the status-bar icon).
     Founder call (reference mock, "Current/Updated" screenshot): the badge
     should read as a plain green "online" status dot, not a glyph or a
     mini copy of the logo — so this is now Material's standard filled-dot
     shape (the "fiber_manual_record" glyph — Apache 2.0,
     https://fonts.google.com/icons), tinted green via
     NotificationCompat.Builder.setColor() in buildNotification(). A prior
     iteration avoided a plain circle here because, tinted the same pink as
     the launcher icon, it read as a redundant second sphere; a solid dot
     in a contrasting bright green instead reads as an intentional status
     indicator (same convention as WhatsApp/Messenger "online" dots), not a
     duplicate of the logo behind it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,12m-9,0a9,9 0 1,0 18,0a9,9 0 1,0 -18,0" />
</vector>
