<?xml version="1.0" encoding="utf-8"?>
<!-- Ayma mark for notification small icons: the two overlapping petal lobes
     from the launcher icon (assets/icon/ayma_sol_icon.png), as a flat white
     silhouette. Status-bar small icons are alpha-only (the system tints
     them), so the sphere is dropped — a filled sphere would be a plain
     circle — and only the petals remain, filling ~85% of the 24dp box.
     Used as the call foreground-service small icon (CallForegroundService)
     and the FCM default push icon (AndroidManifest meta-data). It also
     doubles as the corner badge CallStyle stamps onto the caller's large
     icon on builds that still honor the small icon there, so the badge is
     the mark too. Each lobe is its own path so the overlap unions rather
     than cancelling. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.61,17.70A7.8,3.4 -47 1,1 21.25,6.30A7.8,3.4 -47 1,1 10.61,17.70Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2.75,6.30A7.8,3.4 47 1,1 13.39,17.70A7.8,3.4 47 1,1 2.75,6.30Z" />
</vector>
