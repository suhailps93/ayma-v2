rules_version = '2';

// Baseline security rules — PLAN.md Step 2.
//
// A signed-in user has full read/write over their own `users/{uid}` subtree;
// every other path is denied to all client SDK access. The backend uses the
// Firebase Admin SDK, which bypasses these rules entirely, so all
// backend-authored data (wiki `ai_body`, `raw_turns`, matches, moderation,
// `deleted_accounts`, …) is unaffected.
//
// The finer two-tier ownership boundary from ARCHITECTURE.md §9.2 — carving the
// `ai_only` wiki tier and the backend-only fields out of the owner's own write
// access — is applied later in Step 66. Until then this deliberately broad
// owner-scope is the "for now" baseline that keeps the database closed to
// everyone else.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // DM threads (§6.6): a participant may read the thread and its messages and
    // update their own read cursor. Message writes go through the backend
    // (`POST /dm/{threadId}/messages`), which bypasses rules.
    match /dm_threads/{threadId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['last_read_at']);
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/dm_threads/$(threadId))
               .data.participants;
      }
    }

    // matches/{matchId} (§5.7): both participants may read their shared doc.
    match /matches/{matchId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.uids;
    }

    // Explicit deny-all for every other collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
