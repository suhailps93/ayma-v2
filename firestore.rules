rules_version = '2';

// Final security rules — PLAN.md Step 66 (ARCHITECTURE.md §9.2).
//
// Two tiers, applied per collection:
//  * Direct client read/write (owner only, low-stakes): fcm-token/prefs are
//    backend endpoints now, so client-direct writes are: notification_prefs,
//    `notifications.read`, `wiki_pages.user_edits`/`user_hidden`, user-editable
//    `profile/main` fields, and the `onboarding_started` flag on `users/{uid}`.
//  * Backend-only: everything else under a user's subtree — readable by the
//    owner, never client-writable (`ai_body`, `trust_flags`, `session_mode`,
//    `photos`, `photo_attrs`, `community`, `instagram_access_token`, `raw_turns`,
//    `user_media`, `pending_questions`, `match_candidates`, `likes`, …).
//  * No client access at all: the `ai_only` wiki tier and `deleted_accounts/*`.
//
// The Admin SDK (backend) bypasses all of this.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function changed(only) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(only);
    }

    // ---- users/{uid} account doc -------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      // Client may only flip the onboarding flag (§3.3). fcm_tokens,
      // session_mode, community, trust_flags, instagram_access_token, paused's
      // sibling metadata etc. are all backend-authored.
      allow update: if isOwner(uid)
        && changed(['onboarding_started', 'updated_at']);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['onboarding_started', 'updated_at']);

      // ---- profile/main: user-editable structured fields (§9.2) ---------
      // photos / photo_attrs / community are backend-authored and absent here.
      match /profile/{doc} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'name', 'first_name', 'last_name', 'phone',
               'birthdate', 'gender', 'interested_in', 'location',
               'paused', 'ayma_voice_name', 'ayma_voice_language',
               'updated_at', 'onboarding_started'
             ]);
        allow update: if isOwner(uid)
          && changed([
               'name', 'first_name', 'last_name', 'phone',
               'birthdate', 'gender', 'interested_in', 'location',
               'paused', 'ayma_voice_name', 'ayma_voice_language',
               'updated_at', 'onboarding_started'
             ]);
      }

      // ---- wiki_pages: read non-ai_only; write user-edit fields, and let
      //      the owner move a page between public<->private (never ai_only) --
      match /wiki_pages/{pageId} {
        allow read: if isOwner(uid)
          && resource.data.visibility != 'ai_only';
        allow update: if isOwner(uid)
          && resource.data.visibility != 'ai_only'
          && (
               changed(['user_edits', 'user_hidden', 'user_updated_at'])
               || (
                    changed(['visibility', 'user_updated_at'])
                    && request.resource.data.visibility in ['public', 'private']
                  )
             );
      }

      // ---- notifications: read; mark read / swipe-to-dismiss only -------
      match /notifications/{id} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) && changed(['read', 'dismissed']);
      }

      // ---- notification_prefs: full owner read/write (bools) -----------
      match /notification_prefs/{doc} {
        allow read, write: if isOwner(uid);
      }

      // ---- everything else backend-authored: owner may read, not write --
      match /raw_turns/{id}        { allow read: if isOwner(uid); }
      match /user_media/{id}       { allow read: if isOwner(uid); }
      match /pending_questions/{id} { allow read: if isOwner(uid); }
      match /match_candidates/{id} { allow read: if isOwner(uid); }
      match /likes/{id}           { allow read: if isOwner(uid); }
      match /explore_passed/{id}  { allow read: if isOwner(uid); }
      // Voice-call UI commands (§5.6): backend queues one at
      // app_commands/pending, the client reads it while a call is live and
      // deletes it once handled.
      match /app_commands/{id}    { allow read, delete: if isOwner(uid); }
    }

    // ---- DM threads (§6.6) ------------------------------------------------
    match /dm_threads/{threadId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['last_read_at']);
      match /messages/{messageId} {
        // Membership comes from the sorted-pair thread id ({lo}__{hi}), not a
        // get() on the parent doc — the thread doc doesn't exist until the
        // first message is sent, and a get() on a missing doc errors the
        // listener (the "Conversation" screen would spin forever).
        allow read: if request.auth != null
          && request.auth.uid in threadId.split('__');
      }
    }

    // ---- matches/{matchId} (§5.7): both participants may read ------------
    match /matches/{matchId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.uids;
    }

    // ---- deny everything else (blocks, deleted_accounts, …) -------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
